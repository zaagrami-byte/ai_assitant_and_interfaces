# Vide pour une session manuelle sans caméra. Exemple http://192.168.1.10:8080/video
ISIMM_CAMERA=
# Index PortAudio ou chaîne unique du nom de l’entrée
ISIMM_MIC=
ISIMM_DENOISE=true
ISIMM_PUSH_TO_TALK=false
ISIMM_REVIEW_TEXT=false
ISIMM_VAD=0.62
ISIMM_STT=auto
ISIMM_LLM=auto
ISIMM_VOICE=ff_siwis
ISIMM_VOLUME=0.8
ISIMM_SPEED=1.0
ISIMM_MIN_FACE=0.075
ISIMM_YAW=0.16
ISIMM_IRIS=0.20
ISIMM_PITCH=0.50
ISIMM_COOLDOWN=12
ISIMM_FEEDBACK_DAYS=7
ISIMM_AZURE=false
ISIMM_AZURE_VOICE=ar-TN-ReemNeural
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Écrit les transcriptions, requêtes Ollama et phrases TTS sur stderr pour une session de diagnostic.
ISIMM_DIALOGUE_DEBUG=false
